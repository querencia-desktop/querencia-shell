#!/bin/sh
# Querencia Desktop session starter: runs labwc 0.9.8 with the Querencia
# configuration from the Querencia runtime copy. labwc starts the desktop
# (background and icons) and the panel through its autostart file once the
# Wayland socket exists.
#
#   querencia-session          start the session (from a console login or greetd)
#   querencia-session --exit   end the running Querencia session (also from SSH)
#   querencia-session --labwc-konfig-abgleichen
#                              only bring the user copy of the labwc
#                              configuration up to date (see below), e.g.
#                              after a change of the defaults; inside the
#                              session labwc --reconfigure then reloads it
#
# labwc configuration (QD-046 ②, G2-AG): labwc reads rc.xml, autostart,
# environment and menu.xml from the user copy ~/.config/querencia/labwc,
# where Querencia Einstellungen may change them. The files in the runtime
# copy (session/querencia/labwc) are only the defaults; before each start
# konfig_abgleichen copies missing ones and updates those the user has not
# changed (docs/labwc-benutzerkonfiguration.md). The old way, labwc reading
# the runtime copy directly, comes back with the file
# ~/.config/querencia/labwc-alter-weg or QUERENCIA_LABWC_KONFIG=repo, and by
# itself if the user copy cannot be set up.
#
# Derived from session/classic2-session (M2.0b). The Classic2 session keeps
# its own runtime copy, configuration and state; both are never active for
# the same user at the same time.

set -u

# Fixed on purpose: the session only ever uses the Querencia runtime copy,
# never a development copy, and never the labwc found in PATH.
QUERENCIA_REPO=~/projects/querencia-runtime
LABWC=~/opt/labwc-0.9.8/bin/labwc
LABWC_VERSION=0.9.8
# Defaults (Vorgaben) in the runtime copy, the user copy labwc reads, and
# the switch back to the old way. CONFIG_DIR is chosen right before labwc
# starts.
VORGABE_DIR=$QUERENCIA_REPO/session/querencia/labwc
BENUTZER_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/querencia/labwc
ALTER_WEG=${XDG_CONFIG_HOME:-$HOME/.config}/querencia/labwc-alter-weg
CONFIG_DIR=$VORGABE_DIR
# Installed, checked components (fixed paths, one link per program, see
# sitzung/installieren.sh); without an installed panel the runtime copy's
# own panel build stays in use. The desktop is optional.
COMPONENTS=~/opt/querencia/bin
PANEL=$COMPONENTS/querencia-panel
[ -x "$PANEL" ] || PANEL=$QUERENCIA_REPO/target/debug/querencia-panel
DESKTOP=$COMPONENTS/querencia-desktop
[ -x "$DESKTOP" ] || DESKTOP=
# Querencia Sitzung (G2-K): idle lock after this many minutes without
# input (ext-idle-notify); empty or missing program: no idle lock.
SITZUNG=$COMPONENTS/querencia-sitzung
[ -x "$SITZUNG" ] || SITZUNG=
LEERLAUF_MINUTEN=10
# Querencia polkit agent (G2-K): answers polkit authentication requests of
# this session (there is no other agent); empty: none.
POLKIT_AGENT=$COMPONENTS/querencia-polkit-agent
[ -x "$POLKIT_AGENT" ] || POLKIT_AGENT=
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/querencia

die() {
    echo "querencia-session: $*" >&2
    exit 1
}

# The start time (field 22 of /proc/PID/stat, clock ticks since boot) tells
# a reused PID apart; the same parsing is in querencia/labwc/autostart.
starttime() {
    stat=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    set -- ${stat##*) }
    [ -n "${20-}" ] && echo "${20}"
}

# The boot ID ties labwc records to this boot: the start time counts from
# boot, so after a reboot an old record could otherwise fit a new process.
boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
case $boot_id in
'' | *[!0-9a-f-]*) boot_id= ;;
esac

# labwc is the same binary in the Classic2 and the Querencia session; only
# the configuration directory tells them apart. These are the exact argument
# lists the starter gives labwc, one argument per line: the user copy, or
# the runtime copy (old way, fallback, and a labwc started by an older
# starter before this one was installed).
labwc_argv_benutzer=$(printf '%s\n' "$LABWC" -C "$BENUTZER_DIR")
labwc_argv_vorgabe=$(printf '%s\n' "$LABWC" -C "$VORGABE_DIR")

# labwc record, one line: "q2 BOOTID PID STARTTIME".
labwc_record_for() {
    start=$(starttime "$1") || return 1
    echo "q2 $boot_id $1 $start"
}

# Succeeds while labwc record $1 still describes the very labwc this starter
# runs: same boot, same user, exactly the arguments "$LABWC -C <dir>" with
# the user or the runtime copy as <dir> (from the NUL-separated /proc/PID/cmdline, no further arguments, no
# newline inside an argument) and the same start time. The start time is
# compared last, so a PID reused during the other checks is caught as well.
# Anything else, including malformed or old-format records, is rejected.
labwc_matches() {
    [ -n "$boot_id" ] || return 1
    # Only the characters of a valid record; this also rules out glob
    # characters before the record is split into words.
    case $1 in '' | *[!0-9a-fq\ -]*) return 1 ;; esac
    set -- $1
    [ $# -eq 4 ] && [ "$1" = q2 ] && [ "$2" = "$boot_id" ] || return 1
    pid=$3 start=$4
    case $pid in '' | *[!0-9]*) return 1 ;; esac
    case $start in '' | *[!0-9]*) return 1 ;; esac
    [ "$(ps -o uid= -p "$pid" | tr -d ' ')" = "$(id -u)" ] || return 1
    cmdline=/proc/$pid/cmdline
    [ "$(tr -cd '\000' <"$cmdline" 2>/dev/null | wc -c)" -eq 3 ] || return 1
    [ "$(tr -cd '\n' <"$cmdline" 2>/dev/null | wc -c)" -eq 0 ] || return 1
    argv=$(tr '\000' '\n' <"$cmdline" 2>/dev/null)
    [ "$argv" = "$labwc_argv_benutzer" ] || [ "$argv" = "$labwc_argv_vorgabe" ] || return 1
    [ "$(starttime "$pid")" = "$start" ]
}

# Panel records hold "PID STARTTIME" (written by the autostart file).
# Succeeds while record $1 still describes the very same process of this
# user running program $2. The start time is compared last, so a PID reused
# during the ps calls is caught as well.
matches() {
    pid=${1%% *} start=${1#* }
    case $pid in '' | *[!0-9]*) return 1 ;; esac
    case $start in '' | *[!0-9]*) return 1 ;; esac
    [ "$(ps -o uid= -p "$pid" | tr -d ' ')" = "$(id -u)" ] || return 1
    [ "$(ps -o args= -p "$pid" | cut -d' ' -f1)" = "$2" ] || return 1
    [ "$(starttime "$pid")" = "$start" ]
}

# Removes PID file $1 only while it still holds record $2, never the file of
# a newer session.
remove_record() {
    if [ "$(cat "$1" 2>/dev/null)" = "$2" ]; then
        rm -f "$1"
    fi
}

# Succeeds if a process of this user runs program $1, judged by the first
# word of its command line (with or without a path). The kernel's process
# name is cut to 15 characters; the command line is not, so the check stays
# exact for longer names and is not fooled by programs that merely mention
# the name as an argument.
running() {
    pgrep -u "$(id -u)" -f "^([^ ]*/)?$1( |\$)" >/dev/null
}

# Copies $1 to $2 (mode 0644) through a temporary file in the same
# directory, so labwc never sees half a file.
kopieren() {
    tmp=$(dirname "$2")/.$(basename "$2").neu-$$
    if cp -- "$1" "$tmp" && chmod 0644 "$tmp" && mv -f -- "$tmp" "$2"; then
        return 0
    fi
    rm -f -- "$tmp"
    return 1
}

# Brings the user copy of the labwc configuration up to date with the
# defaults. .vorgabe/ in the user copy keeps the default each user file was
# last taken from: a full copy, not only a checksum, because Querencia
# Einstellungen merges its own settings into a newer rc.xml with it (three
# versions: last default, user file, new default); .vorgabe/stand lists the
# checksums, the commit and the time. Per file, as far as the defaults have
# it:
#   user file missing                  copy the default
#   no record yet (e.g. a file of the user or of Querencia Einstellungen
#   before the first start)            keep the user file, record the default
#   default unchanged since the record nothing
#   user file equals the new default   only record it
#   user file equals the recorded one  the user did not change it: take the
#                                      new default, old file as FILE.vorher-ZEIT
#   both changed                       keep the user file (a user change is
#                                      never overwritten); the new default
#                                      goes to FILE.vorgabe-neu
# Prints one line per action; fails if the user copy cannot be written.
konfig_abgleichen() {
    basis=$BENUTZER_DIR/.vorgabe
    mkdir -p -- "$basis" || return 1
    zeit=$(date +%Y%m%d-%H%M%S)
    geaendert=
    for datei in rc.xml autostart environment menu.xml; do
        v=$VORGABE_DIR/$datei u=$BENUTZER_DIR/$datei b=$basis/$datei
        [ -f "$v" ] || continue
        if [ ! -e "$u" ] && [ ! -L "$u" ]; then
            kopieren "$v" "$u" && kopieren "$v" "$b" || return 1
            echo "angelegt aus der Vorgabe: $u"
        elif [ ! -f "$b" ]; then
            kopieren "$v" "$b" || return 1
            if cmp -s "$u" "$v"; then
                echo "gleich der Vorgabe: $u"
            else
                echo "eigene Datei behalten: $u (ab jetzt Ausgangspunkt: die aktuelle Vorgabe)"
            fi
        elif cmp -s "$v" "$b"; then
            continue
        elif cmp -s "$u" "$v"; then
            kopieren "$v" "$b" || return 1
            rm -f -- "$u.vorgabe-neu"
            echo "Vorgabe ist schon übernommen: $u"
        elif cmp -s "$u" "$b"; then
            cp -p -- "$u" "$u.vorher-$zeit" && kopieren "$v" "$u" && kopieren "$v" "$b" || return 1
            rm -f -- "$u.vorgabe-neu"
            echo "neue Vorgabe übernommen: $u (vorher: $u.vorher-$zeit)"
        else
            if ! cmp -s "$v" "$u.vorgabe-neu"; then
                kopieren "$v" "$u.vorgabe-neu" || return 1
            fi
            echo "Vorgabe geändert, eigene Datei behalten: $u (neue Vorgabe: $u.vorgabe-neu)"
            continue
        fi
        geaendert=ja
    done
    if [ -n "$geaendert" ] || [ ! -f "$basis/stand" ]; then
        commit=$(git -C "$QUERENCIA_REPO" rev-parse --short HEAD 2>/dev/null) || commit=unbekannt
        {
            echo "# Vorgaben in .vorgabe/, zuletzt übernommen von querencia-session"
            echo "# (QD-046, docs/labwc-benutzerkonfiguration.md im Runtime-Repo)"
            echo "zeit $(date '+%F %T')"
            echo "quelle $VORGABE_DIR (commit $commit)"
            (cd "$basis" && for datei in rc.xml autostart environment menu.xml; do
                if [ -f "$datei" ]; then sha256sum "$datei"; fi
            done)
        } >"$basis/stand.neu-$$" && mv -f -- "$basis/stand.neu-$$" "$basis/stand" || return 1
    fi
    return 0
}

# labwc --exit needs LABWC_PID, which only exists inside the session; the
# PID file works from any shell of this user. Only the Querencia state is
# read, so a Classic2 session is never ended by mistake.
if [ "${1-}" = --exit ]; then
    record=$(cat "$STATE_DIR/labwc.pid" 2>/dev/null)
    labwc_matches "$record" ||
        die "keine laufende Querencia-Sitzung gefunden ($STATE_DIR/labwc.pid)"
    # labwc_matches set pid to the checked labwc.
    kill -TERM "$pid" || die "labwc ($pid) konnte nicht beendet werden"
    echo "querencia-session: labwc ($pid) wird beendet"
    exit 0
fi
# Only the files, no session; labwc --reconfigure reloads them afterwards.
if [ "${1-}" = --labwc-konfig-abgleichen ]; then
    konfig_abgleichen || die "Benutzerkopie $BENUTZER_DIR nicht beschreibbar"
    echo "querencia-session: Benutzerkopie $BENUTZER_DIR abgeglichen"
    exit 0
fi
[ $# -eq 0 ] || die "unbekannte Option: $1 (erlaubt: --exit, --labwc-konfig-abgleichen)"

[ "$(readlink -f "$0")" = "$QUERENCIA_REPO/session/querencia-session" ] ||
    die "nur aus der Querencia-Laufzeitkopie starten: $QUERENCIA_REPO/session/querencia-session"

# One graphical session per user: the systemd user manager, the D-Bus
# activation environment and the D-Bus session bus are shared per user.
# Both the Querencia and the Classic2 session run labwc, so a running labwc
# of this user blocks either starter; the panel names are checked as well.
[ -z "${WAYLAND_DISPLAY-}" ] ||
    die "läuft bereits in einer Wayland-Sitzung (WAYLAND_DISPLAY=$WAYLAND_DISPLAY)"
[ -n "${XDG_RUNTIME_DIR-}" ] || die "XDG_RUNTIME_DIR fehlt"
[ -n "${XDG_SESSION_ID-}" ] || die "keine logind-Sitzung (XDG_SESSION_ID fehlt)"
seat=$(loginctl show-session "$XDG_SESSION_ID" -p Seat --value 2>/dev/null)
[ -n "$seat" ] ||
    die "logind-Sitzung $XDG_SESSION_ID hat keinen Sitz; nur nach Anmeldung an der Konsole starten"
for program in labwc querencia-panel querencia-desktop classic2-panel; do
    if running "$program"; then
        die "es läuft bereits ein $program dieses Benutzers (Classic2- oder Querencia-Sitzung aktiv?)"
    fi
done

[ -x "$LABWC" ] || die "labwc fehlt: $LABWC"
version=$("$LABWC" --version 2>/dev/null | cut -d' ' -f2)
[ "$version" = "$LABWC_VERSION" ] ||
    die "falsche labwc-Version '$version' statt $LABWC_VERSION: $LABWC"
for file in environment autostart; do
    [ -r "$VORGABE_DIR/$file" ] || die "fehlt: $VORGABE_DIR/$file"
done
[ -x "$PANEL" ] || die "Panel fehlt: $PANEL (cargo build in der Querencia-Laufzeitkopie)"
[ -n "$boot_id" ] || die "Boot-ID nicht lesbar: /proc/sys/kernel/random/boot_id"

# labwc only updates the D-Bus/systemd activation environment when it knows
# the session bus.
if [ -z "${DBUS_SESSION_BUS_ADDRESS-}" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

mkdir -p "$STATE_DIR" || die "kann $STATE_DIR nicht anlegen"
for log in labwc labwc-konfig panel desktop sitzung polkit-agent; do
    if [ -f "$STATE_DIR/$log.log" ]; then
        mv -f "$STATE_DIR/$log.log" "$STATE_DIR/$log.log.1"
    fi
done

# Which labwc configuration: the user copy, brought up to date first; the
# runtime copy if the old way is asked for or the user copy is not usable.
# The session always starts.
konfig_log=$STATE_DIR/labwc-konfig.log
if [ "${QUERENCIA_LABWC_KONFIG-}" = repo ] || [ -e "$ALTER_WEG" ]; then
    echo "alter Weg erzwungen (QUERENCIA_LABWC_KONFIG=repo oder $ALTER_WEG): labwc liest $VORGABE_DIR" >>"$konfig_log"
elif konfig_abgleichen >>"$konfig_log" 2>&1 &&
    [ -r "$BENUTZER_DIR/environment" ] && [ -r "$BENUTZER_DIR/autostart" ]; then
    CONFIG_DIR=$BENUTZER_DIR
else
    echo "Benutzerkopie $BENUTZER_DIR nicht nutzbar, labwc liest $VORGABE_DIR" >>"$konfig_log"
fi
echo "querencia-session: labwc-Konfiguration $CONFIG_DIR (Protokoll $konfig_log)"
echo "labwc -C $CONFIG_DIR" >>"$konfig_log"
# No labwc or panel of this user runs (checked above), so older records
# are stale. The panel record is named after this starter's PID, which stays
# unique while this starter lives; a later session never shares it.
rm -f "$STATE_DIR/labwc.pid" "$STATE_DIR"/panel.*.pid "$STATE_DIR"/desktop.*.pid
panel_file=$STATE_DIR/panel.$$.pid
desktop_file=$STATE_DIR/desktop.$$.pid

# Read by the autostart file (QUERENCIA_DESKTOP empty: no desktop).
export QUERENCIA_PANEL="$PANEL" QUERENCIA_STATE_DIR="$STATE_DIR" \
    QUERENCIA_PANEL_RECORD="$panel_file" \
    QUERENCIA_DESKTOP="$DESKTOP" QUERENCIA_DESKTOP_RECORD="$desktop_file" \
    QUERENCIA_SITZUNG="$SITZUNG" QUERENCIA_LEERLAUF_MINUTEN="$LEERLAUF_MINUTEN" \
    QUERENCIA_POLKIT_AGENT="$POLKIT_AGENT"
echo "querencia-session: Panel $PANEL, Arbeitsfläche ${DESKTOP:-(keine)}, Leerlaufsperre ${SITZUNG:-(keine)}, polkit-Agent ${POLKIT_AGENT:-(keiner)}"

cd "$HOME" || die "kann nicht nach $HOME wechseln"
echo "querencia-session: starte labwc $LABWC_VERSION, Log $STATE_DIR/labwc.log"
"$LABWC" -C "$CONFIG_DIR" </dev/null >>"$STATE_DIR/labwc.log" 2>&1 &
labwc_pid=$!
labwc_record=$(labwc_record_for "$labwc_pid")
echo "$labwc_record" >"$STATE_DIR/labwc.pid"

# Forward termination to labwc so that it runs its normal shutdown and
# clears the activation environment. labwc is our child, so its PID cannot
# be reused before wait has reaped it. wait returns early on a trapped
# signal, so keep waiting until labwc itself has exited.
trap 'kill -TERM "$labwc_pid" 2>/dev/null' HUP INT TERM
while :; do
    wait "$labwc_pid"
    status=$?
    kill -0 "$labwc_pid" 2>/dev/null || break
done
# labwc is reaped and its PID may be reused; let the short cleanup finish.
trap ':' HUP INT TERM
remove_record "$STATE_DIR/labwc.pid" "$labwc_record"

# GTK ends the panel and the desktop when the Wayland connection is lost.
# Give them a moment, then end a program of this session only if that very
# process is still left over.
leftover() {
    record=$(cat "$1" 2>/dev/null)
    if [ -n "$2" ] && matches "$record" "$2"; then
        sleep 2
        if matches "$record" "$2"; then
            echo "querencia-session: $3 (${record%% *}) läuft nach labwc weiter, sende SIGTERM" >&2
            kill -TERM "${record%% *}"
        fi
    fi
    rm -f "$1"
}
leftover "$panel_file" "$PANEL" Panel
leftover "$desktop_file" "$DESKTOP" Arbeitsfläche

echo "querencia-session: labwc beendet mit Status $status, Logs in $STATE_DIR"
exit "$status"
