[Desktop Entry]
# Brücke (QD-059, Files QF-0t): alte Desktop-ID io.github.lgse.Strata,
# unsichtbar und ohne MimeType; startet Files mit der neuen App-ID
# org.querencia.Files. Desktop (FILES_APPS) und Panel finden die alte ID
# noch; die Brücke fällt frühestens mit Alpha 2.3 weg.
Type=Application
Version=1.5
Name=Querencia Files
GenericName=Dateimanager
Comment=Ordner und Dateien durchsuchen
Exec=/home/user/projects/querencia-files-dev/target/debug/strata %U
TryExec=/home/user/projects/querencia-files-dev/target/debug/strata
Icon=org.querencia.Files
Terminal=false
Categories=GTK;Utility;FileTools;FileManager;
Keywords=Dateien;Ordner;Dateimanager;
StartupNotify=true
StartupWMClass=org.querencia.Files
NoDisplay=true
