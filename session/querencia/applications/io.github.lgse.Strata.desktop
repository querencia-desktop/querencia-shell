[Desktop Entry]
# Querencia Files (Weiterentwicklung von Strata), HMP-04.
# Desktop-ID = GApplication-ID io.github.lgse.Strata, damit labwc und die
# Fensterliste das Fenster dieser Datei zuordnen. Entwicklungsbuild aus
# querencia-files-dev; MimeType=inode/directory macht ihn ohne Eintrag in
# mimeapps.list zum Ordnerprogramm, solange kein anderes festgelegt ist.
Type=Application
Version=1.5
Name=Querencia Files
GenericName=Dateimanager
Comment=Ordner und Dateien durchsuchen
Exec=/home/user/projects/querencia-files-dev/target/debug/strata %U
TryExec=/home/user/projects/querencia-files-dev/target/debug/strata
Icon=folder
Terminal=false
Categories=GTK;Utility;FileTools;FileManager;
MimeType=inode/directory;
Keywords=Dateien;Ordner;Dateimanager;
StartupNotify=true
StartupWMClass=io.github.lgse.Strata
