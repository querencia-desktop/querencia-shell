[Desktop Entry]
# Querencia Files (Weiterentwicklung von Strata), HMP-04; ab QF-0t mit der
# App-ID org.querencia.Files (QD-059). Desktop-ID = GApplication-ID, damit
# labwc und die Fensterliste das Fenster dieser Datei zuordnen.
# Entwicklungsbuild aus querencia-files-dev; MimeType=inode/directory macht
# ihn ohne Eintrag in mimeapps.list zum Ordnerprogramm, solange kein anderes
# festgelegt ist. Der alte Starter io.github.lgse.Strata.desktop bleibt als
# unsichtbare Brücke daneben.
Type=Application
Version=1.5
Name=Querencia Files
GenericName=Dateimanager
Comment=Ordner und Dateien durchsuchen
Exec=/home/user/projects/querencia-files-dev/target/debug/strata %U
TryExec=/home/user/projects/querencia-files-dev/target/debug/strata
Icon=org.querencia.Files
Terminal=false
Categories=GTK;Utility;FileTools;FileManager;
MimeType=inode/directory;
Keywords=Dateien;Ordner;Dateimanager;
StartupNotify=true
StartupWMClass=org.querencia.Files
