<?xml version="1.0" encoding="UTF-8"?>
<!--
  Querencia Desktop labwc configuration (labwc -C, see session/querencia-session).

  Only what Querencia changes is listed; everything else keeps labwc's
  built-in defaults, as before this file existed. labwc drops its default
  keybinds as soon as rc.xml has one <keybind> of its own, so <default />
  loads them again first (labwc-config(5), "<keyboard><default />").
  Mouse bindings are not touched: without a <mouse> section labwc keeps its
  default mouse bindings.

  Execute runs the command without a shell and only expands "~", so the
  launcher is named by its absolute path in the Querencia runtime copy.

  Merged by the Querencia workshop (2026-10-16): QS-0c print key (unchanged)
  plus four workspaces as in GNOME 2 / Ubuntu 10.04 (HMP-07 proposal).
  Querencia-Werkstatt W3 (2026-10-17, QS-1): Print/Alt+Print as in GNOME 2.
  Querencia-Werkstatt W3 (2026-10-17, QS-0d): Print opens the chooser, Alt+Print frames
  the window; both continue in the editor.
-->
<labwc_config>
  <!-- Four workspaces like GNOME 2. popupTime="0": no labwc overlay, the
       panel's workspace switcher (HMP-07) shows the change. -->
  <desktops number="4" popupTime="0" prefix="Arbeitsfläche" />

  <keyboard>
    <default />
    <!-- QS-0d: Print (Druck) opens the Querencia Screenshot chooser
         (screen, frame a window, select an area), Alt+Print starts the
         window capture directly (labwc reports no window bounds: the window
         is framed with the mouse, a fullscreen window is taken exactly).
         Both open the editor afterwards. -->
    <keybind key="Print">
      <action name="Execute"
              command="/home/user/projects/querencia-runtime/session/querencia/querencia-screenshot-start" />
    </keybind>
    <keybind key="A-Print">
      <action name="Execute"
              command="/home/user/projects/querencia-runtime/session/querencia/querencia-screenshot-start --window" />
    </keybind>
    <!-- GNOME 2 (Metacity) workspace keys: Ctrl+Alt+Left/Right switches,
         with Shift the active window moves along. No wrap-around, like
         Metacity and the panel switcher. -->
    <keybind key="C-A-Left">
      <action name="GoToDesktop" to="left" wrap="no" />
    </keybind>
    <keybind key="C-A-Right">
      <action name="GoToDesktop" to="right" wrap="no" />
    </keybind>
    <keybind key="C-A-S-Left">
      <action name="SendToDesktop" to="left" follow="yes" wrap="no" />
    </keybind>
    <keybind key="C-A-S-Right">
      <action name="SendToDesktop" to="right" follow="yes" wrap="no" />
    </keybind>
    <!-- QD-065 (G2-AK, 2026-10-20): Vollbild ein/aus für das aktive Fenster,
         auch für Programme ohne eigenes Vollbild-Kürzel, etwa Xwayland-
         Programme, die nur ein bildschirmgroßes Fenster zeichnen (Horizon
         Client): im Vollbild blendet labwc die Panels aus. Super+F und
         Alt+F11 statt F11, weil labwc-Kürzel jedem Programm vorgehen: F11
         gehörte sonst nicht mehr Firefox, Files oder einer entfernten
         Sitzung (Horizon, VNC), die es selbst nutzen. Metacity hatte für
         Vollbild kein Standardkürzel; beide sind in labwc und GTK frei. -->
    <keybind key="W-f">
      <action name="ToggleFullscreen" />
    </keybind>
    <keybind key="A-F11">
      <action name="ToggleFullscreen" />
    </keybind>
    <!-- QD-078 (G2-AL, 2026-10-20): Super+D wie der Knopf „Arbeitsfläche
         anzeigen“ links im unteren Panel: minimiert alle Fenster der
         aktuellen Arbeitsfläche, der nächste Druck stellt genau diese
         wieder her. Das Panel macht beides (D-Bus an seinem Busnamen);
         läuft kein Panel, tut das Kürzel nichts. -->
    <keybind key="W-d">
      <action name="Execute"
              command="gdbus call --session --dest org.example.Querencia.Panel --object-path /org/example/Querencia/Panel --method org.querencia.Panel.ArbeitsflaecheUmschalten" />
    </keybind>
    <!-- Querencia Sitzung (Querencia-Werkstatt G2-K, 2026-10-18): Ctrl+Alt+L locks the
         screen at once (ext-session-lock, as GNOME 2), Ctrl+Alt+Delete
         opens the session dialog (Abmelden, Bildschirm sperren, Neu
         starten, Herunterfahren). Both run the installed link in
         ~/opt/querencia/bin (sitzung-integrieren.sh). -->
    <keybind key="C-A-l">
      <action name="Execute"
              command="/home/user/opt/querencia/bin/querencia-sitzung --sperren --sofort" />
    </keybind>
    <keybind key="C-A-Delete">
      <action name="Execute"
              command="/home/user/opt/querencia/bin/querencia-sitzung --dialog" />
    </keybind>
    <!-- Querencia Tastenkürzel (G2-R, 2026-10-18): Super+? (Super+Umschalt+ß
         auf der deutschen Tastatur; labwc vergleicht die Modifikatoren
         genau, deshalb W-S-) zeigt die Übersicht aller Kürzel. Läuft über
         den Link in ~/opt/querencia/bin (kuerzel-integrieren.sh). -->
    <keybind key="W-S-question">
      <action name="Execute"
              command="/home/user/opt/querencia/bin/querencia-kuerzel" />
    </keybind>
  </keyboard>
  <!-- Querencia Sitzung and its polkit agent: their dialogs open centred
       on the active output (the default placement policy is "cascade")
       and stay out of the window list and Alt+Tab, like GNOME 2 dialogs. -->
  <windowRules>
    <windowRule identifier="org.querencia.Sitzung*" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="AutoPlace" policy="center" />
    </windowRule>
    <windowRule identifier="org.querencia.PolkitAgent*" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="AutoPlace" policy="center" />
    </windowRule>
    <!-- G2-AA/G2-AG (20.10.2026): Programme mit eingebettetem Fenstersymbol
         (xdg-toplevel-icon); ohne Regel nimmt labwc 0.9.8 zuerst das Symbol
         des Starters. Das Attribut heißt iconPriority (iconPreferClient
         ignoriert labwc stillschweigend). Je App-ID und Programmname. -->
    <windowRule identifier="org.querencia.Einstellungen" iconPriority="client" />
    <windowRule identifier="querencia-einstellungen" iconPriority="client" />
    <windowRule identifier="org.querencia.Editor" iconPriority="client" />
    <windowRule identifier="querencia-editor" iconPriority="client" />
    <windowRule identifier="org.querencia.Systemmonitor" iconPriority="client" />
    <windowRule identifier="querencia-systemmonitor" iconPriority="client" />
  </windowRules>
  <!-- Alt+Tab (G2-R, 2026-10-18): Liste („classic“) mit Symbol, Titel und
       Arbeitsfläche, nur auf dem Bildschirm mit dem Tastaturfokus. Farben
       und Maße stehen im Theme Querencia-Klassisch (osd.*). Gewechselt
       wird wie bei Metacity nur zwischen den Fenstern der aktuellen
       Arbeitsfläche (NextWindow workspace="current", labwc-Standard). -->
  <windowSwitcher preview="yes" outlines="yes" order="focus">
    <osd show="yes" style="classic" output="focused" />
    <fields>
      <field content="icon" width="6%" />
      <field content="title" width="70%" />
      <field content="workspace" width="24%" />
    </fields>
  </windowSwitcher>
  <!-- Querencia-Klassisch (Querencia-Werkstatt W3, Variante B): klassische Fensterknöpfe
       aus dem labwc-Theme in ~/.local/share/themes/Querencia-Klassisch
       (Link auf ~/opt/querencia-theme/…). Ohne diesen Block gilt wieder
       das eingebaute labwc-Theme. G2-R: Schrift des Fensterwechslers wie
       im Panel (Sitzungsschrift Adwaita Sans 11); Symbolthema gnome-human
       (PNG wie GNOME 2, orange Ordner): labwc 0.9.8 ist ohne librsvg
       gebaut und zeigt keine SVG-Symbole, ohne <icon> sucht es im
       (nicht vorhandenen) Symbolthema „Querencia-Klassisch“ und zeigt im
       Fensterwechsler und in der Titelleiste kaum Symbole.
       QD-046 ④ (20.10.2026, Variante A wie Ubuntu 10.04, G2-AG): Schriften
       DejaVu Sans 10, Fenstertitel und Menüüberschrift fett; ersetzt die
       Fensterwechsler-Schrift Adwaita Sans 11 (nicht mehr installiert).
       Der Starter verteilt die Vorgabe in jede unveränderte Benutzerkopie
       (docs/labwc-benutzerkonfiguration.md).
       Symbolthema „Querencia“ (Thema-2, ~/.local/share/icons/Querencia,
       PNG-Stufen 16/22/24, Inherits=gnome-human,hicolor): fehlt ein Symbol,
       kommt es über die Vererbung aus gnome-human bzw. hicolor. Fehlt das
       ganze Thema, gibt es KEINEN Rückfall (labwc 0.9.8 kennt die Vererbung
       nur aus dessen index.theme) und die Titelleisten bleiben ohne Symbol:
       das Thema muss installiert sein (integration/labwc-vorgabe/
       probe-symbolthema.sh, Fall O1). -->
  <theme>
    <name>Querencia-Klassisch</name>
    <icon>Querencia</icon>
    <font place="ActiveWindow">
      <name>DejaVu Sans</name>
      <size>10</size>
      <weight>bold</weight>
    </font>
    <font place="InactiveWindow">
      <name>DejaVu Sans</name>
      <size>10</size>
      <weight>bold</weight>
    </font>
    <font place="MenuHeader">
      <name>DejaVu Sans</name>
      <size>10</size>
      <weight>bold</weight>
    </font>
    <font place="MenuItem">
      <name>DejaVu Sans</name>
      <size>10</size>
    </font>
    <font place="OnScreenDisplay">
      <name>DejaVu Sans</name>
      <size>10</size>
    </font>
  </theme>
</labwc_config>
