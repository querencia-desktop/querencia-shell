msgid "… and {n} more"
msgid_plural "… and {n} more"
msgstr[0] "… und {n} weitere"
msgstr[1] "… und {n} weitere"

#: src/desktop_view.rs:2497
msgid "The trash could not be emptied completely."
msgstr "Der Papierkorb konnte nicht vollständig geleert werden."

