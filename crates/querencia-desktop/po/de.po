msgstr[0] "Möchten Sie das {n} ausgewählte Objekt wirklich endgültig löschen?"
msgstr[1] "Möchten Sie die {n} ausgewählten Objekte wirklich endgültig löschen?"

#: src/desktop_view/transfer.rs:424
msgid "If you delete an item, it will be permanently lost."
msgstr "Wenn Sie ein Objekt löschen, ist es unwiderruflich verloren."

#: src/desktop_view/transfer.rs:425
msgid "Delete"
msgstr "Löschen"

