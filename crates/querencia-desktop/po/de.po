msgid "The trash could not be emptied."
msgstr "Der Papierkorb konnte nicht geleert werden."

#: src/desktop_view.rs:1779
#, no-c-format
msgid "The trash cannot be reached: {why}"
msgstr "Der Papierkorb ist nicht erreichbar: {why}"

#: src/desktop_view.rs:2167
#, no-c-format
msgid "“{name}” cannot be renamed."
msgstr "„{name}“ kann nicht umbenannt werden."

