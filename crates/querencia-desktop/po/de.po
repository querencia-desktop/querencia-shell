msgid "The launcher file was changed in the meantime. Please try again."
msgstr ""
"Die Starter-Datei wurde inzwischen verändert. Bitte versuchen Sie es erneut."

#: src/desktop_view.rs:2642
#, no-c-format
msgid "“{name}” no longer exists."
msgstr "„{name}“ gibt es nicht mehr."

