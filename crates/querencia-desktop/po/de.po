#: src/desktop_view.rs:1726
msgid "Empty all items from the trash?"
msgstr "Möchten Sie alle Dateien im Papierkorb endgültig löschen?"

#: src/desktop_view.rs:1729
msgid "If you empty the trash, all items in it will be permanently lost."
msgstr ""
"Wenn Sie den Papierkorb leeren, werden alle darin befindlichen Objekte unwiderruflich gelöscht."

#: src/desktop_view.rs:1732 src/desktop_view.rs:3136 src/desktop_view/transfer.rs:425 src/volumes.rs:386
msgid "Cancel"
msgstr "Abbrechen"

#: src/desktop_view.rs:1732
msgid "Empty Trash"
msgstr "Papierkorb leeren"

