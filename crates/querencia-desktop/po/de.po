#, no-c-format
msgid ""
"The application launcher “{name}” has not been marked as trusted. If you do not know the source of this file, launching it may be unsafe."
msgstr ""
"Der Anwendungsstarter „{name}“ wurde nicht als vertrauenswürdig markiert. Wenn Sie die Herkunft dieser Datei nicht kennen, kann ihr Start unsicher sein."

#: src/desktop_view.rs:3137
msgid "Mark as Trusted"
msgstr "Als vertrauenswürdig markieren"

#: src/desktop_view.rs:3138
msgid "Launch Anyway"
msgstr "Trotzdem starten"

#: src/desktop_view.rs:3181
msgid "New Document"
msgstr "Neues Dokument"

#: src/desktop_view.rs:3197
msgid "Template"
msgstr "Vorlage"

