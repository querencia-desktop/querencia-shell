#, no-c-format
msgid "“{name}” could not be renamed to “{new}”."
msgstr "„{name}“ konnte nicht in „{new}“ umbenannt werden."

#: src/desktop_view.rs:2294
#, no-c-format
msgid ""
"“{name}” no longer exists. Perhaps it was deleted or moved in the meantime."
msgstr ""
"„{name}“ gibt es nicht mehr. Vielleicht wurde es inzwischen gelöscht oder verschoben."

