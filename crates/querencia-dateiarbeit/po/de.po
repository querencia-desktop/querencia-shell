#: src/auftraege.rs:100
msgid "Error while copying."
msgstr "Beim Kopieren ist ein Fehler aufgetreten."

#: src/auftraege.rs:101
msgid "Error while moving."
msgstr "Beim Verschieben ist ein Fehler aufgetreten."

#: src/auftraege.rs:102
msgid "Error while creating links."
msgstr "Fehler beim Anlegen der Verknüpfungen."

#: src/auftraege.rs:103
msgid "Not everything could be moved to the trash."
msgstr "Nicht alles konnte in den Papierkorb verschoben werden."

#: src/auftraege.rs:104
msgid "Not everything could be deleted."
msgstr "Nicht alles konnte gelöscht werden."

#: src/auftraege.rs:105
msgid "Not everything could be restored."
msgstr "Nicht alles konnte wiederhergestellt werden."

#: src/auftraege.rs:106
msgid "The trash could not be emptied completely."
msgstr "Der Papierkorb konnte nicht vollständig geleert werden."

#: src/auftraege.rs:107
msgid "The folder could not be created."
msgstr "Der Ordner konnte nicht angelegt werden."

#: src/auftraege.rs:108
msgid "The document could not be created."
msgstr "Das Dokument konnte nicht angelegt werden."

#: src/auftraege.rs:109
msgid "The item could not be renamed."
msgstr "Das Objekt konnte nicht umbenannt werden."

#: src/auftraege.rs:331
#, no-c-format
msgid "{n} of {total} items was not copied:"
msgid_plural "{n} of {total} items were not copied:"
msgstr[0] "{n} von {total} Objekten wurde nicht kopiert:"
msgstr[1] "{n} von {total} Objekten wurden nicht kopiert:"

#: src/auftraege.rs:337
#, no-c-format
msgid "{n} of {total} items was not moved:"
msgid_plural "{n} of {total} items were not moved:"
msgstr[0] "{n} von {total} Objekten wurde nicht verschoben:"
msgstr[1] "{n} von {total} Objekten wurden nicht verschoben:"

#: src/auftraege.rs:343
#, no-c-format
msgid "{n} of {total} items was not moved to the trash:"
msgid_plural "{n} of {total} items were not moved to the trash:"
msgstr[0] "{n} von {total} Objekten wurde nicht in den Papierkorb verschoben:"
msgstr[1] "{n} von {total} Objekten wurden nicht in den Papierkorb verschoben:"

#: src/auftraege.rs:349
#, no-c-format
msgid "{n} of {total} items was not deleted:"
msgid_plural "{n} of {total} items were not deleted:"
msgstr[0] "{n} von {total} Objekten wurde nicht gelöscht:"
msgstr[1] "{n} von {total} Objekten wurden nicht gelöscht:"

#: src/auftraege.rs:355
#, no-c-format
msgid "{n} of {total} items could not be deleted and is still in the trash:"
msgid_plural "{n} of {total} items could not be deleted and are still in the trash:"
msgstr[0] ""
"{n} von {total} Objekten konnte nicht gelöscht werden und ist noch im Papierkorb:"
msgstr[1] ""
"{n} von {total} Objekten konnten nicht gelöscht werden und sind noch im Papierkorb:"

#: src/auftraege.rs:361
#, no-c-format
msgid "{n} of {total} items was not restored:"
msgid_plural "{n} of {total} items were not restored:"
msgstr[0] "{n} von {total} Objekten wurde nicht wiederhergestellt:"
msgstr[1] "{n} von {total} Objekten wurden nicht wiederhergestellt:"

#: src/auftraege.rs:367
#, no-c-format
msgid "{n} of {total} items failed:"
msgid_plural "{n} of {total} items failed:"
msgstr[0] "{n} von {total} Objekten ist fehlgeschlagen:"
msgstr[1] "{n} von {total} Objekten sind fehlgeschlagen:"

#. TRANSLATORS: one line of the error list: file name and reason
#: src/auftraege.rs:381
#, no-c-format
msgid "“{name}”: {why}"
msgstr "„{name}“: {why}"

#: src/auftraege.rs:387 src/laufwerke.rs:347
#, no-c-format
msgid "… and {n} more"
msgid_plural "… and {n} more"
msgstr[0] "… und {n} weitere"
msgstr[1] "… und {n} weitere"

#: src/auftraege/lauf.rs:126
msgid "permission denied"
msgstr "keine Berechtigung"

#: src/auftraege/lauf.rs:127 src/auftraege/lauf.rs:418 src/auftraege/lauf.rs:841 src/auftraege/lauf.rs:1030
msgid "no longer there"
msgstr "nicht mehr vorhanden"

#: src/auftraege/lauf.rs:129 src/papierkorb/wiederherstellen.rs:75
msgid "There is already an item with this name at the target."
msgstr "Am Ziel gibt es schon ein Objekt mit diesem Namen."

#: src/auftraege/lauf.rs:131
msgid "There is no space left at the target."
msgstr "Auf dem Ziel ist kein Platz mehr."

#: src/auftraege/lauf.rs:132
msgid "The target is read-only."
msgstr "Das Ziel ist schreibgeschützt."

#: src/auftraege/lauf.rs:134 src/auftraege/lauf.rs:1036
msgid "The name is not allowed at the target."
msgstr "Der Name ist am Ziel nicht erlaubt."

#: src/auftraege/lauf.rs:137
msgid "There is no trash at this location."
msgstr "An diesem Ort gibt es keinen Papierkorb."

#: src/auftraege/lauf.rs:144
msgid "volume not reachable"
msgstr "Datenträger nicht erreichbar"

#: src/auftraege/lauf.rs:331
msgid "Trash"
msgstr "Papierkorb"

#: src/auftraege/lauf.rs:345 src/auftraege/lauf.rs:379
msgid "no target"
msgstr "kein Ziel"

#: src/auftraege/lauf.rs:423
msgid "A folder cannot be copied into itself."
msgstr "Ein Ordner kann nicht in sich selbst kopiert werden."

#: src/auftraege/lauf.rs:424
msgid "A folder cannot be moved into itself."
msgstr "Ein Ordner kann nicht in sich selbst verschoben werden."

#: src/auftraege/lauf.rs:550
msgid "A folder cannot be replaced by an item it contains."
msgstr "Ein Ordner kann nicht durch ein Objekt ersetzt werden, das er enthält."

#: src/auftraege/lauf.rs:699
#, no-c-format
msgid "copied, but the original remained: {why}"
msgstr "kopiert, aber das Original blieb: {why}"

#. TRANSLATORS: digit group separator in "1.2 kB (1,234 bytes)"
#: src/i18n.rs:106 src/typ.rs:114
msgctxt "thousands separator"
msgid ","
msgstr "."

#: src/laufwerke.rs:263
msgid "Eject"
msgstr "Auswerfen"

#: src/laufwerke.rs:264
msgid "Unmount"
msgstr "Aushängen"

#: src/laufwerke.rs:279
#, no-c-format
msgid "“{name}” could not be ejected."
msgstr "„{name}“ konnte nicht ausgeworfen werden."

#: src/laufwerke.rs:280
#, no-c-format
msgid "“{name}” could not be unmounted."
msgstr "„{name}“ konnte nicht ausgehängt werden."

#: src/laufwerke.rs:284
msgid ""
"The volume is still in use. Close all programs and windows that have files on this volume open, and try again."
msgstr ""
"Der Datenträger wird noch benutzt. Schließen Sie alle Programme und Fenster, die Dateien auf diesem Datenträger geöffnet haben, und versuchen Sie es erneut."

#: src/laufwerke.rs:289 src/laufwerke.rs:617
msgid "You do not have the permissions for this volume."
msgstr "Sie haben keine Berechtigung für diesen Datenträger."

#: src/laufwerke.rs:292
msgid "The volume is no longer mounted."
msgstr "Der Datenträger ist nicht mehr eingehängt."

#: src/laufwerke.rs:334
msgid "A program still has files on the volume open."
msgstr "Ein Programm hat noch Dateien auf dem Datenträger geöffnet."

#: src/laufwerke.rs:336
msgid "These programs still have files on the volume open:"
msgstr "Diese Programme haben noch Dateien auf dem Datenträger geöffnet:"

#: src/laufwerke.rs:339
#, no-c-format
msgid "• {program} (process {pid})"
msgstr "• {program} (Prozess {pid})"

#: src/laufwerke.rs:353
msgid ""
"Close the programs, or eject the volume anyway. Unsaved data of these programs may be lost."
msgstr ""
"Schließen Sie die Programme, oder werfen Sie ihn trotzdem aus. Ungesicherte Daten dieser Programme können dabei verloren gehen."

#: src/laufwerke.rs:357
msgid "Eject Anyway"
msgstr "Trotzdem auswerfen"

#: src/laufwerke.rs:360
msgid ""
"Close the programs, or unmount the volume anyway. Unsaved data of these programs may be lost."
msgstr ""
"Schließen Sie die Programme, oder hängen Sie ihn trotzdem aus. Ungesicherte Daten dieser Programme können dabei verloren gehen."

#: src/laufwerke.rs:364
msgid "Unmount Anyway"
msgstr "Trotzdem aushängen"

#: src/laufwerke.rs:370
#, no-c-format
msgid "The volume “{name}” is still in use."
msgstr "Der Datenträger „{name}“ wird noch benutzt."

#: src/laufwerke.rs:372
msgid "Cancel"
msgstr "Abbrechen"

#: src/laufwerke.rs:580
msgid "The volume was mounted, but it has no mount point."
msgstr "Der Datenträger wurde eingehängt, hat aber keinen Einhängepunkt."

#: src/laufwerke.rs:613
#, no-c-format
msgid "“{name}” could not be mounted."
msgstr "„{name}“ konnte nicht eingehängt werden."

#: src/laufwerke.rs:619
msgid "The volume is already mounted."
msgstr "Der Datenträger ist bereits eingehängt."

#. TRANSLATORS: name of a copy next to the original, e.g. "notes (copy).txt"
#: src/namen.rs:46
#, no-c-format
msgid "{stem} (copy){ext}"
msgstr "{stem} (Kopie){ext}"

#. TRANSLATORS: the second, third … copy, e.g. "notes (copy 2).txt"
#: src/namen.rs:52
#, no-c-format
msgid "{stem} (copy {n}){ext}"
msgstr "{stem} (Kopie {n}){ext}"

#. TRANSLATORS: name of a symbolic link, as Nautilus 2.30 named it
#: src/namen.rs:65
#, no-c-format
msgid "Link to {name}"
msgstr "Verknüpfung mit {name}"

#: src/namen.rs:98
msgid "The name cannot be empty."
msgstr "Der Name darf nicht leer sein."

#: src/namen.rs:99
#, no-c-format
msgid ""
"The name “{name}” is not valid because it contains the character “/”. Please use a different name."
msgstr ""
"Der Name „{name}“ ist ungültig, weil er das Zeichen „/“ enthält. Bitte verwenden Sie einen anderen Namen."

#: src/namen.rs:104
#, no-c-format
msgid "“{name}” is not a valid file name. Please use a different name."
msgstr ""
"„{name}“ ist kein gültiger Dateiname. Bitte verwenden Sie einen anderen Namen."

#: src/namen.rs:108
msgid "The name contains an invalid character."
msgstr "Der Name enthält ein ungültiges Zeichen."

#: src/papierkorb/wiederherstellen.rs:56
msgid "The original location is invalid."
msgstr "Der ursprüngliche Ort ist ungültig."

#: src/papierkorb/wiederherstellen.rs:57
msgid "The original location is unavailable."
msgstr "Der ursprüngliche Ort ist nicht bekannt."

#: src/papierkorb/wiederherstellen.rs:59
msgid "It cannot be determined where this item was deleted from."
msgstr "Es lässt sich nicht feststellen, wo dieses Objekt gelöscht wurde."

#: src/papierkorb/wiederherstellen.rs:61
msgid ""
"The volume of the trash cannot be determined because the mount table is unavailable."
msgstr ""
"Der Datenträger des Papierkorbs lässt sich nicht bestimmen, weil die Einhängetabelle fehlt."

#: src/papierkorb/wiederherstellen.rs:64
msgid ""
"The original location is outside the volume of the trash and cannot be restored."
msgstr ""
"Der ursprüngliche Ort liegt außerhalb des Datenträgers des Papierkorbs; das Objekt kann nicht wiederhergestellt werden."

#: src/papierkorb/wiederherstellen.rs:67
msgid ""
"The original location crosses a bind mount or subvolume boundary and cannot be restored."
msgstr ""
"Der ursprüngliche Ort liegt hinter einer Einhängegrenze (Bind-Mount oder Subvolume); das Objekt kann nicht wiederhergestellt werden."

#: src/papierkorb/wiederherstellen.rs:70
msgid "The original location must not be inside the trash."
msgstr "Der ursprüngliche Ort darf nicht im Papierkorb liegen."

#: src/papierkorb/wiederherstellen.rs:71
msgid "The original folder no longer exists."
msgstr "Der ursprüngliche Ordner existiert nicht mehr."

#: src/papierkorb/wiederherstellen.rs:72
msgid ""
"The original folder is a symbolic link; the item cannot be restored there."
msgstr ""
"Der ursprüngliche Ordner ist eine symbolische Verknüpfung; dorthin wird nicht wiederhergestellt."

#: src/papierkorb/wiederherstellen.rs:76
msgid ""
"The file system cannot restore without the risk of replacing data; copy the item instead."
msgstr ""
"Das Dateisystem kann nicht wiederherstellen, ohne Daten zu ersetzen; kopieren Sie das Objekt stattdessen."

#: src/typ.rs:122
#, no-c-format
msgid "{size} ({bytes} bytes)"
msgstr "{size} ({bytes} Bytes)"
