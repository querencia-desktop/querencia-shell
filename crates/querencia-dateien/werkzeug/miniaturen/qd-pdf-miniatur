#!/usr/bin/python3 -I
"""Stellvertreter eines PDF-Thumbnailers für die isolierte Prüfung (Welle C2).

Auf der Entwicklungs-VM ist kein PDF-Thumbnailer installiert (kein
evince-/papers-thumbnailer, kein Poppler-Werkzeug). Damit der Weg über
`/usr/share/thumbnailers` samt `%i %o %s` geprüft werden kann, legt lauf.sh
diese Datei mit `qd-pdf.thumbnailer` ins Prüfprofil. Sie zeichnet eine
A4-Seite mit grauen Zeilen; kein Teil des Programms.

Aufruf: qd-pdf-miniatur [--versuche DRAUSSEN PORT GEHEIM] EINGABE AUSGABE GRÖSSE

Mit --versuche (Integrationstest des Sandkastens, erzeuger.rs) versucht er
vorher, was ein bösartiger Thumbnailer täte: DRAUSSEN, $HOME/boese.txt und
eine Datei neben der Eingabe schreiben (der Test prüft draußen, dass nichts
ankam), 127.0.0.1:PORT erreichen, GEHEIM lesen, Sitzungsvariablen und
/run/user sehen. Gelingt eines der letzten vier, endet er mit Status 10–13.
"""
import os
import socket
import struct
import sys
import zlib


def png(breite, hoehe, zeilen):
    def chunk(art, daten):
        return struct.pack(">I", len(daten)) + art + daten + struct.pack(">I", zlib.crc32(art + daten))

    roh = b"".join(b"\x00" + z for z in zeilen)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", breite, hoehe, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(roh)) + chunk(b"IEND", b""))


def versuche(draussen, port, geheim, eingabe):
    for ziel in (draussen, os.path.join(os.environ.get("HOME", "/"), "boese.txt"),
                 os.path.join(os.path.dirname(eingabe), "daneben.txt")):
        try:
            with open(ziel, "w") as f:
                f.write("boese")
        except OSError:
            pass
    try:
        socket.create_connection(("127.0.0.1", int(port)), timeout=1).close()
        sys.exit(10)
    except OSError:
        pass
    try:
        open(geheim, "rb").read()
        sys.exit(11)
    except OSError:
        pass
    if any(os.environ.get(v) for v in ("DBUS_SESSION_BUS_ADDRESS", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR")):
        sys.exit(12)
    if os.path.exists("/run/user"):
        sys.exit(13)


def main():
    args = sys.argv[1:]
    if args[:1] == ["--versuche"]:
        versuche(args[1], args[2], args[3], args[4])
        args = args[4:]
    eingabe, ausgabe, groesse = args[0], args[1], int(args[2])
    with open(eingabe, "rb") as f:
        if not f.read(5).startswith(b"%PDF-"):
            sys.exit("kein PDF")
    hoehe = groesse
    breite = int(groesse / 1.414)
    zeilen = []
    for y in range(hoehe):
        z = bytearray(b"\xff\xff\xff" * breite)
        rand = max(2, breite // 10)
        if hoehe // 10 < y < hoehe - hoehe // 10 and (y // max(1, hoehe // 40)) % 2 == 0:
            ende = breite - rand - (breite // 4 if (y // max(1, hoehe // 20)) % 5 == 4 else 0)
            for x in range(rand, ende):
                z[3 * x:3 * x + 3] = b"\x88\x8a\x85"
        if y < hoehe // 12:
            for x in range(rand, breite - rand):
                z[3 * x:3 * x + 3] = b"\x34\x65\xa4"
        zeilen.append(bytes(z))
    with open(ausgabe, "wb") as f:
        f.write(png(breite, hoehe, zeilen))


main()
