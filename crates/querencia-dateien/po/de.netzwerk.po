# Querencia Dateien: Teilkatalog Netzwerk (Welle C1, dateien-netzwerk), de.
# Nur msgid/msgstr; werkzeug/i18n.py liest ihn mit po/de.po zusammen,
# „update“ übernimmt ihn bei der Integration in po/de.po (docs/dateien.md §3.7).
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Add _bookmark"
msgstr "_Lesezeichen hinzufügen"

msgid "Bookmark _name:"
msgstr "_Name des Lesezeichens:"

msgid "C_onnect"
msgstr "_Verbinden"

msgid "Choose the type of server and enter its name. The password is asked for when connecting."
msgstr "Wählen Sie die Art des Servers und geben Sie seinen Namen ein. Das Kennwort wird beim Verbinden abgefragt."

msgid "Connect _Anyway"
msgstr "_Trotzdem verbinden"

msgid "Connect _anonymously"
msgstr "An_onym verbinden"

msgid "Connect as u_ser:"
msgstr "Als B_enutzer verbinden:"

msgid "Connect to Server"
msgstr "Mit Server verbinden"

msgid "Connect to _Server…"
msgstr "Mit _Server verbinden …"

msgid "Connect to a server"
msgstr "Mit einem Server verbinden"

msgid "Connecting to “{server}” …"
msgstr "Verbindung zu „{server}“ wird hergestellt …"

msgid "Could not connect to “{server}”."
msgstr "Verbindung zu „{server}“ nicht möglich."

msgid "Custom location"
msgstr "Eigene Adresse"

msgid "Do not write the password into the address. It is asked for when connecting."
msgstr "Schreiben Sie das Kennwort nicht in die Adresse. Es wird beim Verbinden abgefragt."

msgid "Enter the address of the server."
msgstr "Geben Sie die Adresse des Servers ein."

msgid "Enter the name or the address of the server."
msgstr "Geben Sie den Namen oder die Adresse des Servers ein."

msgid "Enter the password for the shared folder “{share}” on the server “{host}”."
msgstr "Geben Sie das Kennwort für die Freigabe „{share}“ auf dem Server „{host}“ ein."

msgid "Enter the password for “{name}”."
msgstr "Geben Sie das Kennwort für „{name}“ ein."

msgid "Enter the password of the proxy server."
msgstr "Geben Sie das Kennwort des Proxy-Servers ein."

msgid "Enter the password of “{user}” on the server “{host}”."
msgstr "Geben Sie das Kennwort von „{user}“ auf dem Server „{host}“ ein."

msgid "Enter user name and password for the shared folder “{share}” on the server “{host}”."
msgstr "Geben Sie Benutzername und Kennwort für die Freigabe „{share}“ auf dem Server „{host}“ ein."

msgid "Enter user name and password for “{name}”."
msgstr "Geben Sie Benutzername und Kennwort für „{name}“ ein."

msgid "FTP (with login)"
msgstr "FTP (mit Anmeldung)"

msgid "Message from the system: {message}"
msgstr "Meldung des Systems: {message}"

msgid "No computers found in the network – File → Connect to Server…"
msgstr "Keine Rechner im Netzwerk gefunden – Datei → Mit Server verbinden …"

msgid "Not connected to “{server}”."
msgstr "Nicht mit „{server}“ verbunden."

msgid "Optional information:"
msgstr "Optionale Angaben:"

msgid "Password Required"
msgstr "Kennwort erforderlich"

msgid ""
"Querencia Dateien read the key of the server over a separate connection. Fingerprint of the {key_type} key:\n"
"{fingerprint}\n"
"Compare it with the fingerprint you know from the administrator of the server."
msgstr ""
"Querencia Dateien hat den Schlüssel des Servers über eine eigene Verbindung gelesen. Fingerabdruck des {key_type}-Schlüssels:\n"
"{fingerprint}\n"
"Vergleichen Sie ihn mit dem Fingerabdruck, den Sie vom Verwalter des Servers kennen."

msgid "SSH (SFTP)"
msgstr "SSH (SFTP)"

msgid "Secure WebDAV (HTTPS)"
msgstr "Sicheres WebDAV (HTTPS)"

msgid "Service _type:"
msgstr "Dienst-_Typ:"

msgid "Sh_are:"
msgstr "_Freigabe:"

msgid "That is not a valid server address."
msgstr "Das ist keine gültige Serveradresse."

msgid "The address does not name a server."
msgstr "Die Adresse nennt keinen Server."

msgid "The address needs a protocol at the start, for example “{example}”."
msgstr "Die Adresse braucht am Anfang ein Protokoll, zum Beispiel „{example}“."

msgid "The bookmark could not be saved: {error}"
msgstr "Das Lesezeichen konnte nicht gespeichert werden: {error}"

msgid "The connection to the server broke off. Check the address, the port and whether the service runs on the server."
msgstr "Die Verbindung zum Server ist abgebrochen. Prüfen Sie die Adresse, den Port und ob der Dienst auf dem Server läuft."

msgid "The connection to the server failed."
msgstr "Die Verbindung zum Server ist gescheitert."

msgid "The connection to the server was closed. Connect again."
msgstr "Die Verbindung zum Server wurde getrennt. Verbinden Sie sich erneut."

msgid "The connection was stopped: while logging in, the server showed a different key than the fingerprint you confirmed ({fingerprint}). ssh has saved that other key. Remove it with “{command}” and ask the administrator of the server for the right fingerprint before you connect again."
msgstr "Die Verbindung wurde abgebrochen: Bei der Anmeldung hat der Server einen anderen Schlüssel gezeigt als den Fingerabdruck, den Sie bestätigt haben ({fingerprint}). ssh hat diesen anderen Schlüssel gespeichert. Entfernen Sie ihn mit „{command}“ und fragen Sie den Verwalter des Servers nach dem richtigen Fingerabdruck, bevor Sie sich erneut verbinden."

msgid "The fingerprint of the server key could not be read, so it cannot be compared here. Confirm it with the administrator of the server before you connect."
msgstr "Der Fingerabdruck des Serverschlüssels ließ sich nicht lesen und kann hier nicht verglichen werden. Bestätigen Sie ihn beim Verwalter des Servers, bevor Sie sich verbinden."

msgid "The identity of the server could not be confirmed, so no connection was made. Ask the administrator of the server for its key fingerprint before you try again."
msgstr "Die Identität des Servers wurde nicht bestätigt, deshalb wurde keine Verbindung hergestellt. Fragen Sie den Verwalter des Servers nach dem Fingerabdruck seines Schlüssels, bevor Sie es erneut versuchen."

msgid "The identity of the server “{host}” is not known yet."
msgstr "Die Identität des Servers „{host}“ ist noch nicht bekannt."

msgid "The login failed. Check the user name and the password."
msgstr "Die Anmeldung ist gescheitert. Prüfen Sie Benutzername und Kennwort."

msgid "The password is kept in the keyring of your session and used for this server next time."
msgstr "Das Kennwort wird im Schlüsselbund Ihrer Sitzung aufbewahrt und beim nächsten Mal für diesen Server verwendet."

msgid "The port must be a number from 1 to 65535."
msgstr "Der Port muss eine Zahl von 1 bis 65535 sein."

msgid "The server cannot be reached. Check the network connection of this computer."
msgstr "Der Server ist nicht erreichbar. Prüfen Sie die Netzwerkverbindung dieses Rechners."

msgid "The server could not be found. Check its name or address."
msgstr "Der Server wurde nicht gefunden. Prüfen Sie seinen Namen oder seine Adresse."

msgid "The server did not accept the user name or the password. Check both and try again."
msgstr "Der Server hat Benutzername oder Kennwort nicht angenommen. Prüfen Sie beides und versuchen Sie es erneut."

msgid "The server did not answer in time. Check that it is switched on and reachable."
msgstr "Der Server hat nicht rechtzeitig geantwortet. Prüfen Sie, ob er eingeschaltet und erreichbar ist."

msgid "The server did not answer within {seconds} seconds. Check that it is switched on and reachable, then try again."
msgstr "Der Server hat nicht innerhalb von {seconds} Sekunden geantwortet. Prüfen Sie, ob er eingeschaltet und erreichbar ist, und versuchen Sie es erneut."

msgid "The server did not provide a list of its shared folders. Enter the name of the share in the dialog “Connect to Server”."
msgstr "Der Server hat keine Liste seiner Freigaben geliefert. Geben Sie den Namen der Freigabe im Dialog „Mit Server verbinden“ ein."

msgid "The server name must not contain spaces, slashes or “@”. Enter the user name in its own field."
msgstr "Der Servername darf keine Leerzeichen, keine Schrägstriche und kein „@“ enthalten. Tragen Sie den Benutzernamen in sein eigenes Feld ein."

msgid "The server refused the connection. Check the type of service and the port, and whether the service runs on the server."
msgstr "Der Server hat die Verbindung abgelehnt. Prüfen Sie die Art des Dienstes, den Port und ob der Dienst auf dem Server läuft."

msgid ""
"The server sent this key fingerprint:\n"
"{fingerprint}\n"
"Compare it with the fingerprint you know from the administrator of the server."
msgstr ""
"Der Server hat diesen Fingerabdruck seines Schlüssels geschickt:\n"
"{fingerprint}\n"
"Vergleichen Sie ihn mit dem Fingerabdruck, den Sie vom Verwalter des Servers kennen."

msgid "The shared folder or the folder does not exist on this server. Check the share and the folder."
msgstr "Die Freigabe oder der Ordner existiert auf diesem Server nicht. Prüfen Sie Freigabe und Ordner."

msgid "This is normal when you connect to this server for the first time. If you connected before, the server may have been replaced, or someone may be pretending to be the server."
msgstr "Das ist normal, wenn Sie sich zum ersten Mal mit diesem Server verbinden. Waren Sie schon einmal verbunden, wurde der Server vielleicht ersetzt – oder jemand gibt sich als dieser Server aus."

msgid "This system cannot connect to “{scheme}” servers. The package “gvfs-backends” provides them."
msgstr "Dieses System kann sich nicht mit „{scheme}“-Servern verbinden. Das Paket „gvfs-backends“ bringt die Unterstützung mit."

msgid "This system cannot open this kind of server address. The package “gvfs-backends” provides the network protocols."
msgstr "Dieses System kann diese Art von Serveradresse nicht öffnen. Das Paket „gvfs-backends“ bringt die Netzwerkprotokolle mit."

msgid "Verify Server Identity"
msgstr "Identität des Servers prüfen"

msgid "WebDAV (HTTP)"
msgstr "WebDAV (HTTP)"

msgid "Windows share (SMB)"
msgstr "Windows-Freigabe (SMB)"

msgid "You log in as “{user}”."
msgstr "Sie melden sich als „{user}“ an."

msgid "_Cancel Connection"
msgstr "Verbindung _abbrechen"

msgid "_Domain name:"
msgstr "_Domänenname:"

msgid "_Domain:"
msgstr "_Domäne:"

msgid "_Folder:"
msgstr "_Ordner:"

msgid "_Location (URI):"
msgstr "Adresse (_URI):"

msgid "_Network"
msgstr "_Netzwerk"

msgid "_Password:"
msgstr "_Kennwort:"

msgid "_Port:"
msgstr "_Port:"

msgid "_Remember password"
msgstr "Kennwort _merken"

msgid "_Server:"
msgstr "_Server:"

msgid "_User name:"
msgstr "_Benutzername:"

msgid "for example server.example or 192.0.2.7"
msgstr "zum Beispiel server.example oder 192.0.2.7"

msgid "for example smb://server/share or \\\\server\\share"
msgstr "zum Beispiel smb://server/freigabe oder \\\\server\\freigabe"

msgid "{folder} on {server}"
msgstr "{folder} auf {server}"

msgid "“{scheme}” is not a network protocol. Use smb://, sftp://, ftp:// or dav://."
msgstr "„{scheme}“ ist kein Netzwerkprotokoll. Verwenden Sie smb://, sftp://, ftp:// oder dav://."
