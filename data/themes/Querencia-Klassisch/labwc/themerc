# Querencia-Klassisch (Variante B) – labwc-Theme für Querencia Desktop.
# Grundlage: themerc-Standardwerte von labwc 0.9.8 (das bisher verwendete
# eingebaute Theme); geändert sind nur Fensterrahmen, Titelleiste und
# Titelknöpfe. Knöpfe: PNG-Dateien in diesem Ordner (iconify, max,
# max_toggled, close; -active/-inactive, _hover). Erzeugt von
# querencia-werkstatt-w3-system/theme-b/werkzeug/theme_b.py.

border.width: 1
window.active.border.color: #7a7570
window.inactive.border.color: #aaa6a2

# Titelleiste: dezenter senkrechter Verlauf (aktiv), flach (inaktiv).
# padding.width 8 ≥ labwc-cornerRadius (8): Die runde obere Fensterecke
# schneidet so keinen Knopf an – die Knöpfe bleiben eckig.
window.titlebar.padding.width: 8
window.titlebar.padding.height: 2
window.active.title.bg: Gradient Vertical
window.active.title.bg.color: #eeece9
window.active.title.bg.colorTo: #d8d4d0
window.inactive.title.bg: Solid
window.inactive.title.bg.color: #f2f1ef
window.active.label.text.color: #000000
window.inactive.label.text.color: #6e6e6e
window.label.text.justify: center

# Knöpfe: 24×22, 2 px Abstand (PNG in Knopfgröße)
window.button.width: 24
window.button.height: 22
window.button.spacing: 2
# Hover zeigen die *_hover-*.png; die Überlagerung bleibt durchsichtig.
window.button.hover.bg.color: #00000000
window.button.hover.bg.corner-radius: 0
# Nur für fehlende Grafiken (xbm-Ersatz von labwc):
window.active.button.unpressed.image.color: #000000
window.inactive.button.unpressed.image.color: #6e6e6e
window.active.button.close.unpressed.image.color: #cc0000
window.inactive.button.close.unpressed.image.color: #c46e6e

# Schatten wie bisher
window.active.shadow.size: 60
window.inactive.shadow.size: 40
window.active.shadow.color: #00000060
window.inactive.shadow.color: #00000040

# Fensterwechsler Alt+Tab (G2-R, nach G2-Q): heller Kasten wie die Menüs
# des Panels (#f5f4f2), dünner grauer Rahmen wie die Fensterrahmen
# (#7a7570, 1 px), Schrift #3c3c3c wie im Panel (Schriftart und -größe in
# rc.xml: <font place="OnScreenDisplay">), Auswahl orange wie die
# Auswahl auf der Arbeitsfläche (#F07746: Rahmen 2 px, Fläche hell).
# Ohne diese Einträge erbt der Wechsler die Titelleistenfarben.
osd.bg.color: #f5f4f2
osd.border.color: #7a7570
osd.border.width: 1
osd.label.text.color: #3c3c3c
# Stil „classic“ (Liste): Symbol, Titel, Arbeitsfläche
osd.window-switcher.style-classic.width: 600
osd.window-switcher.style-classic.padding: 6
osd.window-switcher.style-classic.item.padding.x: 8
osd.window-switcher.style-classic.item.padding.y: 4
osd.window-switcher.style-classic.item.active.border.width: 2
osd.window-switcher.style-classic.item.active.border.color: #F07746
osd.window-switcher.style-classic.item.active.bg.color: #F0774633
osd.window-switcher.style-classic.item.icon.size: 24
# Stil „thumbnail“ (Miniaturen), nur falls rc.xml ihn wählt
osd.window-switcher.style-thumbnail.width.max: 80%
osd.window-switcher.style-thumbnail.padding: 6
osd.window-switcher.style-thumbnail.item.width: 220
osd.window-switcher.style-thumbnail.item.height: 170
osd.window-switcher.style-thumbnail.item.padding: 6
osd.window-switcher.style-thumbnail.item.active.border.width: 2
osd.window-switcher.style-thumbnail.item.active.border.color: #F07746
osd.window-switcher.style-thumbnail.item.active.bg.color: #F0774633
osd.window-switcher.style-thumbnail.item.icon.size: 32
# Umriss des gewählten Fensters: orange, weiß, orange (je 1 px)
osd.window-switcher.preview.border.width: 1
osd.window-switcher.preview.border.color: #F07746,#ffffff,#F07746
