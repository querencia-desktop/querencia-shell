/target
# Rohlog-Archive bleiben lokal (zu groß, enthalten ungefilterte Wayland-Mitschnitte)
docs/assets/*/roh/

# Schutz gegen versehentliches Einchecken von Zugangsdaten und Rohdaten
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
*.qcow2
# Ungefilterte Wayland-Mitschnitte (WAYLAND_DEBUG) enthalten Aktivierungstoken;
# gefilterte Fassungen heißen *-auszug.log
*-wl.log

# G2-R: gebaute Binaries der Nachweise (Prüfsummen in nachweis/SHA256SUMS)
/nachweis/bin/
# G2-R: Release-Binary der Vorlage (Prüfsumme in vorschlag/SHA256SUMS)
/integration/kuerzel/vorschlag/querencia-kuerzel
# G2-J: Laufzeit, Profile und gebaute Werkzeuge der isolierten Prüfung
nachweis/gui/
nachweis/build/querencia-panel
nachweis/build/querencia-lautstaerke
integration/vorschlag/querencia-panel
integration/vorschlag/querencia-lautstaerke
# G2-J: entpackte PipeWire-Pakete (apt-get download + dpkg -x), nur lokale Probe, nicht im Git
nachweis/audio-scratch/
# G2-M: gebaute Binaries der Vorlage und des Nachweises (Summen in SHA256SUMS)
nachweis/build/querencia-netzwerk
integration/vorschlag-netzwerk/querencia-panel
integration/vorschlag-netzwerk/querencia-netzwerk
# G2-Y: Release-Bau der Vorlage und des Nachweises (Summen in SHA256SUMS)
integration/vorschlag-statussymbole/querencia-panel
nachweis/g2y/querencia-panel
# G2-AD: Release-Binaries der Vorlage und des Nachweises (Summen in SHA256SUMS)
integration/vorschlag-kalender/querencia-panel
integration/vorschlag-kalender/querencia-desktop
nachweis/g2ad/querencia-panel
nachweis/g2ad/querencia-desktop

# G2-AI: Release-Binaries der Vorlage nicht ins Repo (nur SHA256SUMS)
/integration/g2ai/vorschlag-panel-desktop/querencia-panel
/integration/g2ai/vorschlag-panel-desktop/querencia-desktop
# G2-AK: Release-Binary des Nachweises und der Vorlage (Summen in SHA256SUMS)
nachweis/g2ak/querencia-panel
integration/g2ak/vorschlag-panel/querencia-panel
nachweis/g2ak-g2ai/querencia-panel
# G2-AL: Release-Binary des Nachweises und der Vorlage (Summen in SHA256SUMS)
nachweis/g2al/querencia-panel
integration/g2al/vorschlag-panel/querencia-panel
# kuerzel-reiter: Release-Binary der Vorlage 0.2.0 (Summe in integration/kuerzel-020/integration/vorlage/SHA256SUMS)
/integration/kuerzel-020/integration/vorlage/querencia-kuerzel

# Vorlage der Integration kuerzel 0.2.1: Release-Binary nicht ins Repo (Summe in integration/kuerzel-021/integration/vorlage/SHA256SUMS)
/integration/kuerzel-021/integration/vorlage/querencia-kuerzel
